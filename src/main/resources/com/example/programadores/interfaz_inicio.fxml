<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="420.0" prefWidth="480.0" spacing="10.0" styleClass="fondo" stylesheets="@/css/estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.programadores.HelloController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="77.0" prefWidth="448.0" styleClass="header">
         <children>
            <VBox alignment="CENTER" prefHeight="74.0" prefWidth="325.0">
               <children>
                  <Label prefHeight="29.0" prefWidth="271.0" styleClass="titulo" text="Bienvenido/a!" />
               </children></VBox>
            <VBox alignment="CENTER" prefHeight="74.0" prefWidth="219.0">
               <children>
                  <Button mnemonicParsing="false" prefHeight="34.0" prefWidth="160.0" styleClass="boton, azul" text="Cerrar sesión">
                     <graphic>
                        <ImageView fitHeight="22.0" fitWidth="49.0" pickOnBounds="true" preserveRatio="true" smooth="true">
                           <image>
                              <Image url="@/images/login.png" />
                           </image>
                        </ImageView>
                     </graphic></Button>
               </children></VBox>
         </children></HBox>
      <HBox prefHeight="40.0" prefWidth="448.0">
         <children>
            <VBox alignment="CENTER_RIGHT" prefHeight="37.0" prefWidth="159.0">
               <children>
                  <Label prefHeight="17.0" prefWidth="120.0" styleClass="texto" text="Filtrar por lenguaje:" />
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="55.0" prefWidth="184.0">
               <children>
                  <ComboBox prefWidth="150.0" />
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox alignment="CENTER" prefHeight="200.0" prefWidth="480.0">
         <children>
            <TableView prefHeight="201.0" prefWidth="400.0">
              <columns>
                <TableColumn prefWidth="75.0" text="Usuario" />
                <TableColumn prefWidth="75.0" text="Género" />
              </columns>
            </TableView>
         </children></HBox>
      <HBox alignment="CENTER_LEFT" prefHeight="62.0" prefWidth="480.0">
         <children>
            <VBox alignment="CENTER_RIGHT" prefHeight="62.0" prefWidth="200.0">
               <children>
                  <Button mnemonicParsing="false" prefHeight="25.0" prefWidth="160.0" styleClass="boton, azul" text="Editar perfil">
                     <graphic>
                        <ImageView fitHeight="18.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true" smooth="true">
                           <image>
                              <Image url="@/images/editar.jpg" />
                           </image>
                        </ImageView>
                     </graphic></Button>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="62.0" prefWidth="100.0">
               <children>
                  <Button mnemonicParsing="false" prefHeight="25.0" prefWidth="70.0" styleClass="boton, azul" text="Excel" />
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="70.0" prefWidth="52.0">
               <children>
                  <Button mnemonicParsing="false" prefHeight="25.0" prefWidth="50.0" styleClass="boton, azul" text="PDF" />
               </children>
            </VBox>
            <VBox alignment="CENTER_RIGHT" prefHeight="62.0" prefWidth="88.0">
               <children>
                  <ImageView fitHeight="59.0" fitWidth="69.0" pickOnBounds="true" preserveRatio="true" smooth="true">
                     <image>
                        <Image url="@/images/logodatos.png" />
                     </image>
                  </ImageView>
               </children></VBox>
         </children></HBox>
   </children>
</VBox>
