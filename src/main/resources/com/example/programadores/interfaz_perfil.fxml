<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER_LEFT" prefHeight="420.0" prefWidth="480.0" spacing="10" styleClass="fondo" stylesheets="@/css/estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.programadores.MenuInicialController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="91.0" prefWidth="440.0">
         <children>
             <ImageView fitHeight="101.0" fitWidth="187.0" preserveRatio="true" smooth="true">
                 <image>
                     <Image url="@/images/editarperfil.png" />
                 </image>
             </ImageView>
            <Label prefHeight="89.0" prefWidth="218.0" styleClass="titulo" text="   EDITAR PERFIL" textAlignment="CENTER" wrapText="true" />
         </children>
      </HBox>
      <VBox alignment="BOTTOM_CENTER" prefHeight="380.0" prefWidth="320.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="200.0">
               <children>
                  <Label prefWidth="140.0" styleClass="texto" text="Nombre de usuario:" />
                  <TextField prefHeight="25.0" prefWidth="200.0" promptText=" Introduce tu usuario  (min. 5 car.)" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="200.0">
               <children>
                  <Label prefWidth="140.0" styleClass="texto" text="Contraseña:" />
                  <TextField prefHeight="25.0" prefWidth="200.0" promptText="Introduce tu contraseña" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="200.0">
               <children>
                  <Label prefWidth="140.0" styleClass="texto" text="Género:" />
                  <RadioButton mnemonicParsing="false" prefHeight="17.0" prefWidth="80.0" text="Hombre" />
                  <RadioButton mnemonicParsing="false" prefHeight="17.0" prefWidth="65.0" text="Mujer" />
                  <RadioButton mnemonicParsing="false" prefHeight="17.0" prefWidth="145.0" text="Prefiero no decirlo" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="200.0">
               <children>
                  <Label prefWidth="180.0" styleClass="texto" text="Lenguaje de programación:" />
                  <ComboBox prefWidth="150.0" />
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="69.0" prefWidth="440.0">
               <children>
                  <HBox alignment="BOTTOM_CENTER" prefHeight="75.0" prefWidth="206.0">
                     <children>
                        <Button mnemonicParsing="false" prefHeight="32.0" prefWidth="177.0" styleClass="boton, azul" text="Guardar cambios">
                           <graphic>
                               <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true" smooth="true">
                                   <image>
                                       <Image url="@/images/guardar.png" />
                                   </image>
                               </ImageView>
                           </graphic></Button>
                     </children>
                  </HBox>
                  <HBox alignment="BOTTOM_CENTER" prefHeight="75.0" prefWidth="153.0">
                     <children>
                        <Button mnemonicParsing="false" prefHeight="32.0" prefWidth="125.0" styleClass="boton" text="Cancelar">
                           <graphic>
                               <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true" smooth="true">
                                   <image>
                                       <Image url="@/images/cancelar.png" />
                                   </image>
                               </ImageView>
                           </graphic></Button>
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children></VBox>
   </children>
</VBox>
