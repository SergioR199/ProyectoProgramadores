<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="420.0" prefWidth="480.0" spacing="6.0" styleClass="fondo" stylesheets="@/css/estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.programadores.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <HBox alignment="TOP_CENTER" prefHeight="89.0" prefWidth="345.0">
      <children>
         <VBox alignment="CENTER_RIGHT" prefHeight="123.0" prefWidth="133.0">
            <children>
                <ImageView fitHeight="119.0" fitWidth="119.0" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@/images/logo.png" />
                    </image>
                </ImageView>
            </children>
         </VBox>
         <VBox alignment="CENTER_LEFT" prefHeight="123.0" prefWidth="203.0">
            <children>
               <Label prefHeight="101.0" prefWidth="189.0" styleClass="titulo" text="COMUNIDAD DE PROGRAMADORES" textAlignment="CENTER" wrapText="true">
                  <font>
                     <Font name="JetBrains Mono Bold" size="12.0" />
                  </font></Label>
            </children>
         </VBox>
      </children>
   </HBox>
   <HBox alignment="CENTER_LEFT" prefHeight="43.0" prefWidth="345.0">
      <children>
         <VBox alignment="CENTER_RIGHT" prefHeight="200.0" prefWidth="105.0">
            <children>
                <Label fx:id="welcomeText" prefHeight="30.0" prefWidth="85.0" styleClass="texto" text="Usuario:" />
            </children>
         </VBox>
         <VBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0">
            <children>
               <TextField fx:id="txtUsuarioLogin" prefHeight="30.0" prefWidth="200.0" promptText=" Introduce tu usuario  (min. 5 car.)" />
            </children>
         </VBox>
      </children>
   </HBox>
   <HBox alignment="CENTER_LEFT" prefHeight="47.0" prefWidth="345.0">
      <children>
         <VBox alignment="CENTER_RIGHT" prefHeight="61.0" prefWidth="105.0">
            <children>
               <Label prefHeight="30.0" prefWidth="85.0" styleClass="texto" text="Contraseña:" />
            </children>
         </VBox>
         <VBox alignment="CENTER" prefHeight="61.0" prefWidth="200.0">
            <children>
               <TextField fx:id="txtPasswordLogin" prefHeight="30.0" prefWidth="228.0" promptText="Introduce tu contraseña" />
            </children>
         </VBox>
      </children>
   </HBox>
   <HBox alignment="CENTER" prefHeight="68.0" prefWidth="345.0">
      <children>
         <VBox alignment="CENTER_LEFT" prefHeight="68.0" prefWidth="192.0">
            <children>
                <Button onAction="#onHelloButtonClick" prefHeight="30.0" prefWidth="120.0" styleClass="boton, azul" text="Login">
                  <graphic>
                     <ImageView fitHeight="23.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true" smooth="true">
                      <image>
                          <Image url="@/images/login.png" />
                      </image>
                     </ImageView>
                  </graphic>
                  <font>
                     <Font name="Fira Code Regular" size="12.0" />
                  </font>
               </Button>
            </children>
         </VBox>
         <VBox alignment="CENTER" prefHeight="75.0" prefWidth="184.0">
            <children>
               <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="120.0" styleClass="boton" text="Registrarse">
                  <graphic>
                      <ImageView fitHeight="23.0" fitWidth="41.0" pickOnBounds="true" preserveRatio="true" smooth="true">
                          <image>
                              <Image url="@/images/signup.png" />
                          </image>
                      </ImageView>
                  </graphic>
                  <font>
                     <Font name="Corbel" size="12.0" />
                  </font>
               </Button>
            </children>
         </VBox>
      </children>
   </HBox>
</VBox>
